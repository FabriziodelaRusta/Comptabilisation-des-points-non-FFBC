      rowData[m.membre - 1] = body.membre;
      rowData[m.points - 1] = parseInt(body.points, 10) || 0;
      rowData[m.description - 1] = body.description || '';
      rowData[m.checkbox - 1] = false; // Case décochée par défaut
      rowData[m.source - 1] = 'WebApp RPA';
      rowData[m.mail - 1] = body.mail || '';
      rowData[m.dateOperation - 1] = body.dateOperation;

      sheet.appendRow(rowData);
      return jsonResponse({ success: true, message: "Opération enregistrée avec succès !" });
